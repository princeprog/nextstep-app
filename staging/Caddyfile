# HTTPS front for the production-like staging copy of NextStep. scripts/staging.ps1 (Caddy on this machine, listening
# on 127.0.0.1) and staging/compose.yaml (Caddy in a container, published only on 127.0.0.1) set every variable below.
# Certificates come from Caddy's own local authority, which isn't added to any trust store, so browsers warn and the
# staging tests ignore that warning.
{
	admin off
	auto_https disable_redirects
	local_certs
	skip_install_trust
	storage file_system "{$NEXTSTEP_CADDY_STORAGE}"
	http_port {$NEXTSTEP_HTTP_PORT}
	https_port {$NEXTSTEP_HTTPS_PORT}
}

# The app. Like a hosting provider's proxy, Caddy terminates TLS, replaces any X-Forwarded-For the client sent with the
# real client address, and sets X-Forwarded-Proto. The app forwards /api/v1 to the API with those headers unchanged.
app.nextstep.localhost:{$NEXTSTEP_HTTPS_PORT} {
	bind {$NEXTSTEP_BIND}
	tls internal
	encode zstd gzip
	reverse_proxy {$NEXTSTEP_APP_UPSTREAM}
}

# The static website, built with production settings.
nextstep.localhost:{$NEXTSTEP_HTTPS_PORT} {
	bind {$NEXTSTEP_BIND}
	tls internal
	encode zstd gzip
	root * "{$NEXTSTEP_SITE_ROOT}"
	try_files {path} {path}/index.html
	file_server
}
